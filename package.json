{
  "name": "@stackbox-dev/fp-plugins",
  "version": "2.14.0",
  "description": "Fastify Plugins used in various stackbox applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:stackbox-dev/fp-plugins.git"
  },
  "scripts": {
    "prepare": "husky",
    "pretty": "prettier --write \"./src/**/*.{js,ts,json,md}\"",
    "clean": "rimraf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "transpile": "tsc -p tsconfig.build.json",
    "build": "run-s clean transpile",
    "prepublishOnly": "npm run build"
  },
  "author": "Stackbox <dev@stackbox.xyz>",
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,json,md}": "prettier --write"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/credential-provider-node": "^3.972.39",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.31.0",
    "@google-cloud/storage": "^7.19.0",
    "fastify-plugin": "^5.1.0"
  },
  "peerDependencies": {
    "fastify": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
